GoTo:
  class_name: ${PROJECT_NAME}::GoToAction
  description: "Commands the vehicle to go to a specified position. The reference frame can be set via the 'frame' input port"
  topic: go_to_(input:frame)

GoToLocal:
  class_name: ${PROJECT_NAME}::GoToAction
  description: "Commands the vehicle to go to a specified position in the local coordinate frame"
  topic: go_to_(input:frame)
  port_default:
    frame: local

GoToGlobal:
  class_name: ${PROJECT_NAME}::GoToAction
  description: "Commands the vehicle to go to a specified position in the global coordinate frame"
  topic: go_to_(input:frame)
  port_default:
    frame: global

SendVehicleCommand:
  class_name: ${PROJECT_NAME}::SendVehicleCommand
  description: "Publishes a raw PX4 VehicleCommand (command id + param1..param7) while respecting mode-executor ownership"
  # The topic (incl. its message version suffix) is resolved in the node implementation, see SendVehicleCommand.
  request_timeout: 3.0 # Ack timeout is inferred from the `request_timeout` field of the node registration options.

SendCmdSetNavState:
  class_name: ${PROJECT_NAME}::SendCmdSetNavState
  description: "Switches the active PX4 flight mode (by nav_state) while respecting mode-executor ownership"
  # The topic (incl. its message version suffix) is resolved in the node implementation, see SendVehicleCommand.

SendCmdDoReposition:
  class_name: ${PROJECT_NAME}::SendCmdDoReposition
  description: "Commands the vehicle to reposition to a global WGS84 location (VEHICLE_CMD_DO_REPOSITION) while respecting mode-executor ownership"
  # The topic (incl. its message version suffix) is resolved in the node implementation, see SendVehicleCommand.

CheckNavState:
  class_name: ${PROJECT_NAME}::CheckNavState
  description: "Succeeds once the vehicle's active PX4 navigation state (nav_state) matches the expected one"
  # The topic (incl. its message version suffix) is resolved in the node implementation, see CheckNavState.

CheckArmingState:
  class_name: ${PROJECT_NAME}::CheckArmingState
  description: "Succeeds once the vehicle's PX4 arming state matches the expected one (1 = disarmed, 2 = armed)"
  # The topic (incl. its message version suffix) is resolved in the node implementation, see CheckArmingState.

CheckModeCompleted:
  class_name: ${PROJECT_NAME}::CheckModeCompleted
  description: "Succeeds once the PX4 mode with the expected nav_state reports successful completion (mode_completed)"
  # The topic (incl. its message version suffix) is resolved in the node implementation, see CheckModeCompleted.

GetModeNavState:
  class_name: ${PROJECT_NAME}::GetModeNavState
  description: "Resolves a PX4 mode's name to its nav_state (mode id) - builtin modes plus any registered custom mode"
  topic: registered_modes

GetGlobalPosition:
  class_name: ${PROJECT_NAME}::GetPosition<GlobalPositionMsg>
  description: "Gets the current position of the vehicle in the global coordinate frame"
  # The topic (incl. its message version suffix) is resolved in the node implementation, see GetPosition.

GetLocalPosition:
  class_name: ${PROJECT_NAME}::GetPosition<LocalPositionMsg>
  description: "Gets the current position of the vehicle in the local coordinate frame"
  # The topic (incl. its message version suffix) is resolved in the node implementation, see GetPosition.

SetActuators:
  class_name: ${PROJECT_NAME}::SetActuatorsAction
  description: "Sends direct actuator commands (motors and/or servos) to the vehicle"
  topic: set_actuators
